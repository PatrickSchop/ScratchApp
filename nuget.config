<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- GitHub Packages for PS.AppPlatform -->
    <add key="github" value="https://nuget.pkg.github.com/PatrickSchop/index.json" />
    <!-- NuGet.org for all other packages -->
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Package source mapping -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="PS.AppPlatform*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- GitHub Packages credentials (use GITHUB_TOKEN in GitHub Actions) -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="github-actions[bot]" />
      <add key="ClearTextPassword" value="$([System.Environment]::GetEnvironmentVariable('GH_TOKEN'))" />
    </github>
  </packageSourceCredentials>
</configuration>
