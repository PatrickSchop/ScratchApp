<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- NuGet.org for all packages (GitHub source added by CI/deploy workflows) -->
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Package source mapping: allows both github and nuget sources -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="PS.AppPlatform*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
